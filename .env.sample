# LiveKit Cloud or Self-Hosted SFU configuration
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Speech-to-Text (STT) - Deepgram Nova-2 streaming
DEEPGRAM_API_KEY=your_deepgram_api_key

# Text-to-Speech (TTS) - Cartesia Sonic
CARTESIA_API_KEY=your_cartesia_api_key

# LLM Intelligence - OpenAI or OpenAI-compatible endpoint (e.g. vLLM / Ollama)
OPENAI_API_KEY=your_openai_api_key
# Optional: OpenAI base URL for vLLM or custom endpoints
# OPENAI_BASE_URL=http://localhost:8000/v1

# Tavus Conversational Video Interface (CVI) configuration
TAVUS_API_KEY=your_tavus_api_key
NEXT_PUBLIC_TAVUS_PAL_ID=p8c17a8f2901
